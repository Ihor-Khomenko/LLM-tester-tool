<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ua.ihkh.oberih-runner.plist and edit paths.
     Then: research/runner/bin/ctl.sh load -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ua.ihkh.oberih-runner</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Prefer the policy venv python; absolute path recommended for launchd. -->
    <string>/Users/YOU/Documents/University/oberih-tests/venv-fafd500/bin/python</string>
    <string>/Users/YOU/Documents/University/oberih-tests/runner/lib/supervisor.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/Documents/University/oberih-tests/runner</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OBERIH_RUNNER_ROOT</key>
    <string>/Users/YOU/Documents/University/oberih-tests/runner</string>
    <key>OBERIH_TESTS_ROOT</key>
    <string>/Users/YOU/Documents/University/oberih-tests</string>
    <key>RESEARCH_ROOT</key>
    <string>/Users/YOU/Documents/University/oberih-tests</string>
    <key>PYTHONPATH</key>
    <string>/Users/YOU/Documents/University/oberih-tests/LLM-tester-tool-fafd500</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Documents/University/oberih-tests/runner/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Documents/University/oberih-tests/runner/logs/launchd.err</string>
</dict>
</plist>
