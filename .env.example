# Copy to .env and fill in the keys you need.
# Never commit .env.

# OpenAI
OPENAI_API_KEY=

# xAI Grok (https://api.x.ai/v1)
XAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=

# Requesty (OpenAI-compatible router) — never commit real keys
REQUESTY_API_KEY=
# REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Generic OpenAI-compatible router / local endpoint
# OPENAI_COMPAT_API_KEY=ollama
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1

# Ollama OpenAI-compatible endpoint (optional; default key is "ollama")
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides for other providers
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# PromptGuard 2 weights (optional baseline; CI skips when missing)
# PROMPT_GUARD_MODEL_PATH=
